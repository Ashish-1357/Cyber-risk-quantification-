# Cyber Risk Platform - Root Environment Configuration
# This file documents all environment variables

# Copy to server/.env and customize

# Application
APP_NAME="Cyber Risk Quantification Platform"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Security
SECRET_KEY=your-256-bit-secret-key-here
API_KEY_HEADER=X-API-Key

# CORS - Comma-separated list
CORS_ORIGINS=http://localhost:5500,http://localhost:3000

# FAIR Model Configuration
DEFAULT_SIMULATIONS=50000
MAX_SIMULATIONS=100000

# Optimization Defaults
DEFAULT_BUDGET=3000000
DEFAULT_STAFF_CAPACITY=50
DEFAULT_RISK_APPETITE=5000000

# Data Generation
NUM_ASSETS=500
NUM_VULNERABILITIES_PER_ASSET=2

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
