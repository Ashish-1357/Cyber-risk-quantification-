# Cyber Risk Platform - Environment Configuration
# Copy this file to .env and update values

# Application
APP_NAME="Cyber Risk Quantification Platform"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Security
SECRET_KEY=change-this-to-a-256-bit-secret-key-in-production
API_KEY_HEADER=X-API-Key

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5500

# FAIR Model
DEFAULT_SIMULATIONS=50000
MAX_SIMULATIONS=100000

# Optimization
DEFAULT_BUDGET=3000000
DEFAULT_STAFF_CAPACITY=50
DEFAULT_RISK_APPETITE=5000000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Data Generation
NUM_ASSETS=500
NUM_VULNERABILITIES_PER_ASSET=2
